datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma" 
}

// 1. A ENTIDADE PAI (TENANT)
// Por que? Tudo no SaaS deve pertencer a uma Igreja. 
// Se amanhã você quiser deletar os dados de uma igreja que cancelou a assinatura, 
// o banco de dados limpa tudo em cascata.

model Church {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // ex: "igreja-central-luanda"
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  timezone String @default("Africa/Luanda") // 👈 NOVO

  // Relações
  users       User[]
  members     Member[]
  departments Department[]
  finances    FinanceTransaction[]
  auditLogs   AuditLog[]
  categories   FinanceCategory[] // 👈 ADICIONADO
  subscription Subscription?     // 👈 ADICIONADO
  memberRoles  MemberRole[]
  events Event[]
  eventCategories EventCategory[]
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// 2. UTILIZADORES DO SISTEMA (STAFF)
// Por que? Diferenciamos 'User' (quem faz login) de 'Member' (quem frequenta a igreja).
// Nem todo membro tem acesso ao painel administrativo.

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  password      String?   // ADICIONADO: Essencial para o seu Credentials com bcrypt
  emailVerified DateTime? // ADICIONADO: Exigido pelo Auth.js
  image         String?   // ADICIONADO: Exigido pelo Auth.js
  role     UserRole @default(OPERATOR)
  locale String @default("pt") // 👈 NOVO — "pt" ou "fr"
  churchId String? // 👈 Transformamos em OPCIONAL
  church   Church?   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  // Relações exigidas pelo Auth.js Adapter
  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // 👈 NOVO — Soft Delete

  @@index([churchId])
  @@index([deletedAt]) // 👈 índice para filtrar activos rapidamente
}

enum UserRole {
  SUPER_ADMIN // O dono do SaaS (Você)
  ADMIN // O Pastor/Líder da Igreja
  TREASURER // Acesso apenas a finanças
  SECRETARY // Acesso a membros e eventos
  OPERATOR // Acesso apenas leitura
}

// ADICIONADO: Necessário para o Auth.js gerenciar logins (Google, Facebook, etc no futuro)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ADICIONADO: Se você usar sessões em banco de dados (estamos usando JWT, mas o Adapter pede)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 3. MEMBROS
// Por que? Usamos IDs únicos (cuid) para facilitar a sincronização com Apps Mobile no futuro.

model Member {
  id       String   @id @default(cuid())
  name     String
  email    String?
  phone    String?
  status   MemberStatus @default(ATIVO) // 👈 Mudou para Enum
  joinDate DateTime @default(now())
  deletedAt DateTime? // 👈 NOVO


  // Relação com o cargo (FK)
  roleId    String?
  role      MemberRole?  @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  // Um membro pode liderar departamentos
  ledDepartments Department[] @relation("DepartmentLeader")
  departmentMembers DepartmentMember[] // 👈 NOVO

  eventAttendances EventAttendee[]

  // ÍNDICES COMPOSTOS PARA PERFORMANCE NO SAAS
  @@index([churchId, name])
  @@index([churchId, email])
  @@index([churchId, status, joinDate]) // 👈 NOVO — acelera o gráfico de membros
  @@index([churchId, deletedAt]) // 👈 índice para filtrar activos
}

enum MemberStatus {
  ATIVO
  INATIVO
  TRANSFERIDO
  FALECIDO
}

//  Cargos Flexíveis por Igreja
model MemberRole {
  id       String @id @default(cuid())
  name     String // "Catequista", "Presbítero", "Diácono"
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  members  Member[]

  @@unique([churchId, name]) 
  @@index([churchId])
}

// 4. FINANÇAS 
// centesimal em dízimos e ofertas de grande valor em Kwanza (AOA).

model FinanceTransaction {
  id          String          @id @default(cuid())
  description String
  amount      BigInt   // 👈 era Int — BigInt suporta valores até 92 quadrilhões de cêntimos
  type        TransactionType
  date        DateTime        @default(now())

  // RELAÇÃO COM A CATEGORIA (Mudou de String para isso aqui 👇)
  categoryId  String
  category    FinanceCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, date])
}

enum TransactionType {
  INCOME
  EXPENSE
}

// 5. NOVA TABELA DE CATEGORIAS
// Em vez de uma String solta, agora a categoria é um registro real.
model FinanceCategory {
  id        String          @id @default(cuid())
  name      String          // Ex: "Dízimo", "Construção", "Luz"
  type      TransactionType // INCOME ou EXPENSE
  
  churchId  String
  church    Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  transactions FinanceTransaction[]

  @@unique([churchId, name, type]) // Uma igreja não pode ter dois "Dízimos" de entrada
  @@index([churchId])
}

// 6. NOVA TABELA DE ASSINATURA
// Para controlar quem pagou e até quando pode usar o sistema.
model Subscription {
  id           String             @id @default(cuid())
  churchId     String             @unique
  church       Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  status       SubscriptionStatus @default(TRIALING)
  plan             Plan               @default(FREE)        // 👈 NOVO
  billingCycle     BillingCycle       @default(MONTHLY)     // 👈 NOVO
  startDate    DateTime           @default(now())
  endDate      DateTime?          
  
  // Controle financeiro do SaaS
  currentPeriodEnd DateTime       // 👈 Útil para saber quando vence a mensalidade
  
  paymentProvider  String?        // "Stripe", "Multicaixa", "Transferencia"

  // 👈 NOVOS campos para transferência manual
  pendingPlan      Plan?              // plano pedido mas ainda não confirmado
  pendingCycle     BillingCycle?      // ciclo pedido
  proofOfPayment   String?            // URL do comprovativo
  proofUploadedAt  DateTime?          // quando foi submetido
  confirmedBy      String?            // userId do SUPER_ADMIN que confirmou
  confirmedAt      DateTime?          // quando foi confirmado
  rejectedAt       DateTime?          // quando foi rejeitado
  rejectionReason  String?            // motivo da rejeição
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt // 👈 Importante para saber quando o plano mudou
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}


// 7. DEPARTAMENTOS
model Department {
  id          String  @id @default(cuid())
  name        String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaderId String?
  leader   Member? @relation("DepartmentLeader", fields: [leaderId], references: [id])

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  members  DepartmentMember[] // 👈 NOVO
  events Event[]

  @@index([churchId])
}

// 👇 NOVA TABELA DE JUNÇÃO
model DepartmentMember {
  departmentId String
  memberId     String
  joinedAt     DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([departmentId, memberId])
  @@index([departmentId])
  @@index([memberId])
}

// 9. EVENTOS
model Event {
  id          String      @id @default(cuid())
  name        String
  description String?
  startAt     DateTime  // 👈 substitui date + time — nome mais claro

  categoryId   String
  category     EventCategory @relation(fields: [categoryId], references: [id])

  // Departamento opcional
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  // Presenças
  attendees EventAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, startAt]) // 👈 índice actualizado
}

model EventCategory {
  id       String @id @default(cuid())
  name     String // "Oração", "Culto", "Ensaio"
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  events Event[]

  @@unique([churchId, name])
  @@index([churchId])
}

// Tabela de presenças
model EventAttendee {
  eventId  String
  memberId String

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

// 8. AUDITORIA
model AuditLog {
  id            String   @id @default(cuid())
  churchId      String?  // 👈 torna opcional para logs de sistema
  userId        String?  // Quem realizou a ação
  userEmail     String?  // E-mail para consulta rápida no painel
  action        String   // Ex: "CREATE", "UPDATE", "DELETE"
  entityName    String   // Ex: "Member", "Finance"
  entityId      String   // ID do registro afetado
  oldData       Json?    // Snapshot antes da alteração
  newData       Json?    // Snapshot depois da alteração
  ipAddress     String?
  createdAt     DateTime @default(now())

  church        Church?   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  // Índices otimizados para consultas de suporte e painéis de admin
  @@index([churchId, createdAt(sort: Desc)])
  @@index([entityName, entityId])
  @@index([churchId, entityName, action])  // 👈 NOVO — filtros combinados
  @@index([userId])                         // 👈 NOVO — rastrear por utilizador
}